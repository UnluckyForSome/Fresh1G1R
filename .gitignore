# Retool directory (cloned dynamically)
retool/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Metadata files (machine-specific, regenerated on each run)
**/.metadata.json

# Scraper failure diagnostics (screenshots and page HTML)
debug/

# Run outputs: published as the daily GitHub release, never committed
daily-1g1r-dat/
daily-virgin-dat/
report/

# release.py working files (previous release, manifests, zips, notes)
.release/
